digraph UML {
  graph [rankdir=LR, splines=polyline, nodesep=0.35, ranksep=0.6, pad=0.25, bgcolor="white"];
  node [shape=box, fontname="DejaVu Sans", fontsize=10, margin="0.12,0.08"];
  edge [fontname="DejaVu Sans", fontsize=8, arrowsize=0.7];

  subgraph cluster_fm {
    label="Factory Method"; style=rounded;
    Device [label="<<interface>>\nDevice\n----------------\ngetName()\ngetFamily()\nconnect()\nrunDiagnostic()"];
    DeviceCreator [label="<<abstract>>\nDeviceCreator\n----------------\ncreateDevice(): Device\ninstallAndCheckDevice(): String"];
    LightCreator [label="LightCreator"];
    ThermostatCreator [label="ThermostatCreator"];
    SecurityCreator [label="SecurityCreator"];
    StandardLight [label="StandardLight"];
    StandardThermostat [label="StandardThermostat"];
    StandardSecurity [label="StandardSecuritySystem"];
    LightCreator -> DeviceCreator [arrowhead=empty];
    ThermostatCreator -> DeviceCreator [arrowhead=empty];
    SecurityCreator -> DeviceCreator [arrowhead=empty];
    LightCreator -> StandardLight [style=dashed,label="creates"];
    ThermostatCreator -> StandardThermostat [style=dashed,label="creates"];
    SecurityCreator -> StandardSecurity [style=dashed,label="creates"];
  }

  subgraph cluster_products {
    label="Product interfaces"; style=rounded;
    Light [label="<<interface>>\nLight\n----------------\nturnOn(brightness)\nturnOff()"];
    Thermostat [label="<<interface>>\nThermostat\n----------------\nsetTemperature(value)"];
    Security [label="<<interface>>\nSecuritySystem\n----------------\narm()\ndisarm()"];
    Light -> Device [arrowhead=empty];
    Thermostat -> Device [arrowhead=empty];
    Security -> Device [arrowhead=empty];
  }

  subgraph cluster_af {
    label="Abstract Factory"; style=rounded;
    SmartHomeFactory [label="<<interface>>\nSmartHomeFactory\n----------------\ncreateLight()\ncreateThermostat()\ncreateSecuritySystem()\ngetFamilyName()"];
    BudgetFactory [label="BudgetFactory"];
    PremiumFactory [label="PremiumFactory"];
    EcoFactory [label="EcoFactory"];
    IndustrialFactory [label="IndustrialFactory"];
    BudgetFactory -> SmartHomeFactory [arrowhead=empty,style=dashed];
    PremiumFactory -> SmartHomeFactory [arrowhead=empty,style=dashed];
    EcoFactory -> SmartHomeFactory [arrowhead=empty,style=dashed];
    IndustrialFactory -> SmartHomeFactory [arrowhead=empty,style=dashed];
  }

  subgraph cluster_families {
    label="Concrete product families"; style=rounded;
    Budget [label="Budget family\n----------------\nBudgetLight\nBudgetThermostat\nBudgetSecuritySystem"];
    Premium [label="Premium family\n----------------\nPremiumLight\nPremiumThermostat\nPremiumSecuritySystem"];
    Eco [label="Eco family\n----------------\nEcoLight\nEcoThermostat\nEcoSecuritySystem"];
    Industrial [label="Industrial family\n----------------\nIndustrialLight\nIndustrialThermostat\nIndustrialSecuritySystem"];
  }

  BudgetFactory -> Budget [style=dashed,label="creates"];
  PremiumFactory -> Premium [style=dashed,label="creates"];
  EcoFactory -> Eco [style=dashed,label="creates"];
  IndustrialFactory -> Industrial [style=dashed,label="creates"];

  Budget -> Light [style=dashed]; Budget -> Thermostat [style=dashed]; Budget -> Security [style=dashed];
  Premium -> Light [style=dashed]; Premium -> Thermostat [style=dashed]; Premium -> Security [style=dashed];
  Eco -> Light [style=dashed]; Eco -> Thermostat [style=dashed]; Eco -> Security [style=dashed];
  Industrial -> Light [style=dashed]; Industrial -> Thermostat [style=dashed]; Industrial -> Security [style=dashed];

  FactoryProvider [label="FactoryProvider\n----------------\ngetFactory(family): SmartHomeFactory"];
  Controller [label="SmartHomeController\n----------------\nstartMorningMode()\nleaveHome()\nstartNightMode()\nproductsAreCompatible()"];
  Main [label="Main"];
  FactoryProvider -> SmartHomeFactory [style=dashed,label="selects"];
  Main -> FactoryProvider [style=dashed];
  Main -> Controller [style=dashed];
  Controller -> SmartHomeFactory [label="uses one factory"];
  Controller -> Light; Controller -> Thermostat; Controller -> Security;
}
